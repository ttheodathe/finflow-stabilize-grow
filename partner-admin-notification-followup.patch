     .single();
 
   if (error) throw new PartnerServiceError("SUBMIT_APPLICATION_FAILED", error.message);
+
+  // Best-effort — a failed staff-notification email should never fail the
+  // applicant's submission, which already succeeded above.
+  fetch("/api/public/partners/notify-new-application", {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ applicationId: data.id }),
+    keepalive: true,
+  }).catch(() => {});
+
   return data as PartnerApplication;
 }
 
