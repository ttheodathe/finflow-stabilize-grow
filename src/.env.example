# Environment variables

Copy this file to `.env` for local development, and set the same keys in
Vercel under Project Settings → Environment Variables for each environment
(Production / Preview / Development) you deploy to.

## AI features (OCR, receipt scanning, AI Bookkeeper categorization)
# Required by: src/lib/document-ai.functions.ts, src/lib/ai-receipts.functions.ts,
# src/lib/ai-bookkeeper.functions.ts
# Get this from your Lovable.dev account/project → AI Gateway.
# Missing this produces "Missing LOVABLE_API_KEY" and breaks all OCR/AI
# extraction features at once, since they all share it.
LOVABLE_API_KEY=

# Free alternative to LOVABLE_API_KEY for document-ai.functions.ts specifically
# (the main OCR pipeline — Expenses/Bills/Items/Estimates scanning). Used
# automatically if LOVABLE_API_KEY isn't set. Get a free key with no credit
# card at https://aistudio.google.com (Get API key). Free tier is rate-limited
# (roughly 10 requests/minute, a few hundred/day depending on model) — fine
# for one company's own usage, NOT a substitute for a real paid AI budget if
# this is meant to serve many FinFlowTrack customers at once, since they'd
# all share one quota pool.
# ai-receipts.functions.ts and ai-bookkeeper.functions.ts don't use this yet
# — they're still Lovable-only.
GEMINI_API_KEY=
# Optional override if the free-tier model name changes (it has before) —
# defaults to "gemini-3.5-flash" if unset.
GEMINI_MODEL=

## Billing — Polar (current billing provider)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# "sandbox" or "production"
POLAR_SERVER=sandbox

## Billing — Paddle (legacy, kept for reference during/after migration)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox

## Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

## App URL (used in email links, etc.)
APP_URL=https://www.finflowtrack.com

## External sync (Supabase-to-Supabase, if used)
EXTERNAL_SUPABASE_URL=
EXTERNAL_SUPABASE_SERVICE_ROLE_KEY=
SYNC_CRON_SECRET=
